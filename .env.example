# Default runs a loopback-only demo with embedded Postgres and simulated sensors.
APP_MODE=demo
PORT=5173

# For APP_MODE=supabase, set all four values below.
# DATABASE_URL=postgresql://...
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# DEVICE_TOKEN=generate-a-random-token-of-at-least-32-characters
# HOST=127.0.0.1
