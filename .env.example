# Live API. Leave commented for the local demo.
# APP_MODE=supabase
# DATABASE_URL=postgresql://...
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# DEVICE_TOKEN=generate-a-random-token-of-at-least-32-characters

# OpenRouter. Set on the API and worker.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Photon Spectrum messaging. Set on the API and worker.
# PHOTON_ENABLED=true
# PHOTON_PROJECT_ID=your-spectrum-project-id
# PHOTON_PROJECT_SECRET=your-spectrum-project-secret
# PHOTON_WEBHOOK_SECRET=your-webhook-signing-secret
# Set PHOTON_LINE_NUMBER only for a dedicated Photon line.
# PHOTON_LINE_NUMBER=+14155550100
# PHOTON_CONTACTS='{"office":{"ownerUserId":"00000000-0000-4000-8000-000000000001","ownerPhone":"+14155550101","technicianPhone":"+14155550102"}}'

# Optional Arduino temperature calibration. Use measured values.
# THERMISTOR_CALIBRATION='{"office":{"adc_max":1023,"points":[{"raw":510,"celsius":20},{"raw":440,"celsius":26}]}}'
